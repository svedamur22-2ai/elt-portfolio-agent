# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# --- Jira (Section 4) -------------------------------------------------
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace_me

# --- LLM provider (LangChain / LangGraph nodes) -----------------------
# Also required by Mem0MemoryStore below — mem0's OSS Memory() class uses
# OpenAI for both fact-extraction and embeddings by default, even in
# "local" mode (confirmed: constructing Memory() without this set raises
# OpenAIError). MEM0_API_KEY is NOT needed for that class — it's only for
# the hosted MemoryClient (platform.mem0.ai), which src/services/memory_store.py
# doesn't use.
OPENAI_API_KEY=replace_me

# --- Mem0 (Section 11) -------------------------------------------------
# Only needed if src/services/memory_store.py is later swapped to the
# hosted mem0.MemoryClient instead of the OSS mem0.Memory() class.
MEM0_API_KEY=replace_me
# organization_id / portfolio_id for memory scoping come from
# config/project_mapping.yaml, not from env vars — see MemoryScope in
# src/services/memory_store.py.

# --- Financial datasource (Section 5) -----------------------------------
# "mock" reads data/sample/financial_mock_data.csv via MockFinancialDataSource.
# Swap to sql / snowflake / oracle / rest as later adapters are implemented.
FINANCIAL_SOURCE_TYPE=mock
FINANCIAL_SOURCE_CSV_PATH=data/sample/financial_mock_data.csv

# --- App -----------------------------------------------------------
LOG_LEVEL=INFO
